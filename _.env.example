# my.telegram.org -> API development tools se lo
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Public channel ka username (bina @ ke)
TG_CHANNEL=channel_username

# aistudio.google.com se Gemini API key
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# 1 karoge to report Telegram ke Saved Messages me bhi aayegi (default 0 = sirf local file)
SEND_TO_TELEGRAM=0
MAX_ZIP_MB=50
DELAY_BETWEEN_ZIPS=20

# --- Render ke liye ---
# gen_session.py chala ke jo string mile wo yahan daalo
TG_SESSION=
# Render pe 1 rakhna, kyunki wahan reports/ folder restart pe mit jata hai
# SEND_TO_TELEGRAM=1
PING_EVERY=600
